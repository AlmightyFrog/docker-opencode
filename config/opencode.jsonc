{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "read", "resource": "/tmp/*", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/workspace/*", "effect": "allow" },
    { "action": "read", "resource": "/workspace/*", "effect": "allow" },
    { "action": "edit", "resource": "/workspace/*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": ".env", "effect": "ask" },
    { "action": "read", "resource": "*/.env", "effect": "ask" }
  ]
}
